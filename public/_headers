# Cache static assets for 1 year
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS and JS for 1 week
*.css
  Cache-Control: public, max-age=604800, must-revalidate

*.js
  Cache-Control: public, max-age=604800, must-revalidate

# Cache fonts for 1 year
*.woff2
*.woff
*.ttf
*.eot
  Cache-Control: public, max-age=31536000, immutable

# Cache HTML for 1 hour (for static sites)
*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Enable compression
/
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block

# Security headers
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com;
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
