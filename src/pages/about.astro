---
import PageHeader from "@/components/PageHeader.astro";
import Shape from "@/components/Shape.astro";
import Experiences from "@/components/about/Experiences.astro";
import WorldMap from "@/components/about/WorldMap.astro";
import Works from "@/components/about/Works.astro";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const about = (await getEntry("about", "-index")) as CollectionEntry<"about">;
const { worldmap, experiences, profile_highlights, features } = about.data;
const page_data = {
  ...about.data,
  content: about.body,
};

const meta_keywords = "ergothérapeute bordeaux, mégane bertaud ergothérapeute, valeurs ergothérapeute, approche ergothérapie bordeaux, rééducation fonctionnelle";
---

<Base
  title={about.data.title}
  meta_title={about.data.meta_title}
  description={about.data.description}
  image={about.data.image}
  meta_keywords={meta_keywords}
>
  <Shape />
  <section class="page-hero py-16">
    <div class="container">
      <div
        class="page-hero-content about-page-header mx-auto max-w-[768px] text-center"
      >
        <PageHeader page_data={page_data} />
      </div>
      {
        profile_highlights && profile_highlights.length > 0 && (
          <div class="mx-auto mt-10 grid max-w-[980px] gap-4 md:grid-cols-3">
            {profile_highlights.map((highlight) => (
              <div class="rounded-[2rem] bg-white px-5 py-4 text-left shadow-lg ring-1 ring-border/50 transition duration-300 hover:-translate-y-1 hover:shadow-2xl hover:ring-primary/30">
                <h2 class="mb-2 text-xl font-semibold text-text-dark">
                  {markdownify(highlight.title)}
                </h2>
                <p
                  class="text-sm leading-relaxed"
                  set:html={markdownify(highlight.content)}
                />
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  {features && <Works features={features} />}

  <Experiences experiences={experiences} />

  <section class="pb-16">
    <div class="container">
      <WorldMap worldmap={worldmap} />
    </div>
  </section>
</Base>
