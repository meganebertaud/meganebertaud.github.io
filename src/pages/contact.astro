---
import PageHeader from "@/components/PageHeader.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const entry = (await getEntry(
  "contact",
  "-index"
)) as CollectionEntry<"contact">;
const { appointment_url, cabinet, location, availability, email, phone } =
  config.params;
const contact = entry.data;
const page_data = {
  ...contact,
  content: entry.body,
};
---

<Base
  title={contact.title}
  meta_title={contact.meta_title}
  description={contact.description}
  image={contact.image}
>
  <section class="page-hero pb-6 pt-16">
    <div class="container">
      <PageHeader page_data={page_data} />
    </div>
  </section>

  <section class="section pt-0">
    <div class="container">
      <div class="row">
        <div class="mb-10 text-center md:col-6 md:order-2 md:mb-0 md:pt-9">
          <div class="contact-img relative inline-flex pb-5 pl-5">
            <Image
              class="rounded-[2rem] shadow-xl"
              src="/images/occupational-therapy.jpg"
              height={544}
              width={500}
              alt="Ergothérapeute en extérieur"
            />
            <Image
              class="absolute bottom-0 left-0 -z-[1] h-14 w-14"
              src="/images/shape-2.png"
              alt=""
              height={56}
              width={56}
            />
          </div>
        </div>
        <div class="md:col-6 md:order-1">
          <div class="mb-8 rounded-xl bg-light p-6 lg:max-w-[484px]">
            <h2 class="h4 mb-3">Prendre rendez-vous</h2>
            <p class="mb-5">
              La prise de rendez-vous se fait en ligne via Docorga.
            </p>
            <a
              class="btn btn-primary block w-full text-center"
              href={appointment_url}
              target="_blank"
              rel="noopener noreferrer"
            >
              Prendre rendez-vous sur Docorga
            </a>
          </div>

          <div class="grid gap-4 lg:max-w-[484px]">
            <div class="rounded-xl bg-white p-5 shadow-lg ring-1 ring-border/50">
              <h2 class="h5 mb-2">Par e-mail</h2>
              <a class="hover:text-primary" href={`mailto:${email}`}>{email}</a>
            </div>

            <div class="rounded-xl bg-white p-5 shadow-lg ring-1 ring-border/50">
              <h2 class="h5 mb-2">Par téléphone</h2>
              <a class="hover:text-primary" href={`tel:${phone}`}>{phone}</a>
            </div>

            <div class="rounded-xl bg-white p-5 shadow-lg ring-1 ring-border/50">
              <h2 class="h5 mb-2">{cabinet}</h2>
              <p>{location}</p>
              {availability && <p class="mt-2">{availability}</p>}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
