---
import PageHeader from "@/components/PageHeader.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const entry = (await getEntry(
  "contact",
  "-index"
)) as CollectionEntry<"contact">;
const { contact_form_action, appointment_url } = config.params;
const contact = entry.data;
const page_data = {
  ...contact,
  content: entry.body,
};
---

<Base
  title={contact.title}
  meta_title={contact.meta_title}
  description={contact.description}
  image={contact.image}
>
  <section class="page-hero pb-6 pt-16">
    <div class="container">
      <PageHeader page_data={page_data} />
    </div>
  </section>

  <section class="section pt-0">
    <div class="container">
      <div class="row">
        <div class="mb-10 text-center md:col-6 md:order-2 md:mb-0 md:pt-9">
          <div class="contact-img relative inline-flex pb-5 pl-5">
            <Image
              src="/images/contact-img.png"
              height={544}
              width={500}
              alt=""
            />
            <Image
              class="absolute bottom-0 left-0 -z-[1] h-14 w-14"
              src="/images/shape-2.png"
              alt=""
              height={56}
              width={56}
            />
          </div>
        </div>
        <div class="md:col-6 md:order-1">
          <div class="mb-8 rounded-xl bg-light p-6 lg:max-w-[484px]">
            <h2 class="h4 mb-3">Prendre rendez-vous</h2>
            <p class="mb-5">
              La prise de rendez-vous se fait en ligne via Docorga.
            </p>
            <a
              class="btn btn-primary block w-full text-center"
              href={appointment_url}
              target="_blank"
              rel="noopener noreferrer"
            >
              Prendre rendez-vous sur Docorga
            </a>
          </div>

          <form
            class="lg:max-w-[484px]"
            action={contact_form_action}
            method="POST"
          >
            <div class="form-group mb-5">
              <label class="form-label" for="name">Nom complet</label>
              <input
                class="form-control"
                type="text"
                id="name"
                name="name"
                placeholder="Votre nom complet"
              />
            </div>
            <div class="form-group mb-5">
              <label class="form-label" for="email">Adresse e-mail</label>
              <input
                class="form-control"
                type="email"
                id="email"
                name="email"
                placeholder="Votre adresse e-mail"
              />
            </div>
            <div class="form-group mb-5">
              <label class="form-label" for="reason">Motif</label>
              <select name="reason" id="reason" class="form-select" required>
                <option value="">Sélectionnez un motif</option>
                <option value="renseignements">Demande de renseignements</option>
                <option value="collaboration">Projet de collaboration</option>
                <option value="opportunite">Opportunité professionnelle</option>
                <option value="autre">Autre</option>
              </select>
            </div>
            <div class="form-group mb-5">
              <label class="form-label" for="message">Votre message</label>
              <textarea
                class="form-control"
                id="message"
                name="message"
                cols="30"
                rows="6"></textarea>
            </div>
            <input
              class="btn btn-primary block w-full"
              type="submit"
              value="Envoyer le message"
            />
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>
