---
import { markdownify } from "@/lib/utils/textConverter";
import ResponsiveImage from "@/components/ResponsiveImage.astro";
const { banner } = Astro.props;
const { title, button, image, content } = banner;
const imageAlt =
  title?.toString().replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim() ||
  "Mégane Bertaud, ergothérapeute à Bordeaux";
---

<section class="section banner relative">
  <div class="container">
    <div class="row items-center">
      <div class="lg:col-7">
        <h1 class="banner-title" set:html={markdownify(title)} />

        <p class="mt-6" set:html={markdownify(content)} />

        {
          button.enable && (
            <a class="btn btn-white mt-8" href={button.link}>
              {button.label}
            </a>
          )
        }
      </div>
      <div class="mt-10 lg:col-5 lg:mt-0">
        <ResponsiveImage
          class="mx-auto w-full max-w-[360px] object-contain lg:max-w-[420px]"
          alt={imageAlt}
          src={image}
          width={400}
          height={400}
          widths={[200, 400]}
          sizes="(min-width: 1024px) 420px, min(360px, 100vw)"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <img
    class="banner-shape absolute -top-28 right-0 -z-[1] w-full max-w-[30%]"
    alt="Décor graphique chaleureux"
    src="/images/banner-shape-warm.png"
    width={496}
    height={466}
  />
</section>
