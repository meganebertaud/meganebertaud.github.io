---
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";

type Props = {
  key_features: CollectionEntry<"homepage">["data"]["key_features"];
};

const { key_features } = Astro.props as Props;
const { title, description, feature_list } = key_features;

const iconPaths = {
  FiHeart: [
    "M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z",
  ],
  FiActivity: ["M22 12h-4l-3 9L9 3l-3 9H2"],
  FiHome: [
    "M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z",
    "M9 22V12h6v10",
  ],
  FiTrendingUp: [
    "M23 6l-9.5 9.5-5-5L1 18",
    "M17 6h6v6",
  ],
  FiShield: [
    "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z",
  ],
  FiUser: [
    "M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2",
    "M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z",
  ],
};

const getIconPaths = (icon: string) =>
  Object.prototype.hasOwnProperty.call(iconPaths, icon)
    ? iconPaths[icon as keyof typeof iconPaths]
    : iconPaths.FiHeart;
---

<section class="section key-feature relative">
  <img
    class="absolute left-0 top-0 -z-[1] -translate-y-1/2"
    src="/images/feature-shape-warm.png"
    height={126}
    width={63}
    alt=""
  />
  <div class="container">
    <div class="mx-auto max-w-[820px] text-center">
      <h2 set:html={markdownify(title)} />
      <p class="mt-6" set:html={markdownify(description)} />
    </div>
    {
      feature_list && feature_list.length > 0 && (
        <div class="key-feature-grid mt-10 grid grid-cols-1 gap-7 sm:grid-cols-2 md:grid-cols-3">
          {feature_list.map((item) => (
            <div class="flex flex-col justify-between rounded-lg bg-white p-5 shadow-lg">
              <div>
                <h3 class="h4 text-xl lg:text-2xl">{item.title}</h3>
                <p>{item.content}</p>
              </div>
              <span class="icon mt-8">
                <svg
                  class="h-6 w-6 text-primary"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  {getIconPaths(item.icon).map((path) => (
                    <path d={path} />
                  ))}
                </svg>
              </span>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
