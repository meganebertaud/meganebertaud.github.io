---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
  service: CollectionEntry<"homepage">["data"]["service"];
};
const { service } = Astro.props;
const { photos } = service;
---

{
  photos && photos.length > 0 && (
    <section class="section services pt-0" aria-label="Photos personnelles">
      <div class="container">
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {photos.map((photo) => (
            <Image
              class="h-72 w-full rounded-2xl object-cover shadow-sm md:h-80"
              alt={photo.alt ?? ""}
              width={700}
              height={520}
              src={photo.image}
            />
          ))}
        </div>
      </div>
    </section>
  )
}
