---
import config from "@/config/config.json";
import { Image } from "astro:assets";
const { src } = Astro.props;
const {
  logo,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;
---

<a href="/" class="navbar-brand flex items-center gap-2.5">
  {
    src || logo ? (
      <>
        <Image
          class="rounded-full"
          width={logo_width.replace("px", "") * 2}
          height={logo_height.replace("px", "") * 2}
          src={src ? src : logo}
          alt={title}
          style={{
            height: logo_height.replace("px", "") + "px",
            width: logo_width.replace("px", "") + "px",
          }}
        />
        {logo_text && <span class="font-secondary text-xl leading-tight">{logo_text}</span>}
      </>
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>
