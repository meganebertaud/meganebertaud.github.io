---
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";

type EngagementCycle = NonNullable<
  CollectionEntry<"about">["data"]["engagement_cycle"]
>;

type Props = {
  engagement_cycle: EngagementCycle;
};

const { engagement_cycle } = Astro.props as Props;

const palette = [
  {
    fill: "#C16C58",
    accent: "#C16C58",
    contrast: "#FFFFFF",
    card: "rgba(193, 108, 88, 0.10)",
  },
  {
    fill: "#D98C7A",
    accent: "#D98C7A",
    contrast: "#FFFFFF",
    card: "rgba(217, 140, 122, 0.10)",
  },
  {
    fill: "#E5B299",
    accent: "#B0846B",
    contrast: "#3E362F",
    card: "rgba(229, 178, 153, 0.16)",
  },
  {
    fill: "#B0846B",
    accent: "#B0846B",
    contrast: "#FFFFFF",
    card: "rgba(176, 132, 107, 0.12)",
  },
  {
    fill: "#4A3F38",
    accent: "#4A3F38",
    contrast: "#FFFFFF",
    card: "rgba(74, 63, 56, 0.10)",
  },
];

const angles = [-90, -18, 54, 126, 198];
const radius = 36;

const getLabelClass = (index: number) => {
  switch (index) {
    case 0:
      return "left-1/2 top-0 w-60 -translate-x-1/2 -translate-y-[calc(100%+1.25rem)] text-center";
    case 1:
      return "left-[calc(100%+1.25rem)] top-1/2 w-64 -translate-y-1/2 text-left";
    case 2:
      return "left-[calc(100%+1rem)] top-1/2 w-64 -translate-y-1/2 text-left";
    case 3:
      return "right-[calc(100%+1rem)] top-1/2 w-64 -translate-y-1/2 text-right";
    default:
      return "right-[calc(100%+1.25rem)] top-1/2 w-64 -translate-y-1/2 text-right";
  }
};

const items = engagement_cycle.items.map((label, index) => {
  const angle = angles[index] ?? -90 + (index * 360) / engagement_cycle.items.length;
  const radians = (angle * Math.PI) / 180;
  const x = 50 + Math.cos(radians) * radius;
  const y = 50 + Math.sin(radians) * radius;

  return {
    label,
    index,
    x,
    y,
    number: String(index + 1).padStart(2, "0"),
    palette: palette[index % palette.length],
    labelClass: getLabelClass(index),
  };
});
---

<section class="mx-auto mt-12 max-w-[1080px]">
  <div class="rounded-[2rem] bg-white/95 px-6 py-10 shadow-xl ring-1 ring-border/60 md:px-10">
    <div class="mx-auto max-w-[980px]">
      <h2
        class="text-center font-secondary text-h2-sm text-text-dark lg:hidden md:text-h2"
        set:html={markdownify(engagement_cycle.title)}
      />

      <div class="relative mx-auto mt-12 hidden aspect-square max-w-[760px] lg:block">
        <div class="absolute inset-[15%] rounded-full border-2 border-dashed border-primary/25"></div>
        <div class="absolute inset-[26%] rounded-full border border-secondary/50"></div>

        <div class="absolute left-1/2 top-1/2 flex h-52 w-52 -translate-x-1/2 -translate-y-1/2 flex-col items-center justify-center rounded-full bg-body text-center shadow-[inset_0_0_30px_rgba(193,108,88,0.10)] ring-1 ring-primary/15">
          <span class="font-secondary text-4xl text-text-dark">Mon</span>
          <span class="mt-2 text-xs font-semibold uppercase tracking-[0.22em] text-primary">
            engagement
          </span>
        </div>

        {
          items.map((item) => (
            <div
              class="absolute"
              style={`left:${item.x}%; top:${item.y}%; transform: translate(-50%, -50%);`}
            >
              <div
                class="relative flex h-16 w-16 items-center justify-center rounded-full text-lg font-semibold shadow-lg ring-4 ring-white"
                style={`background-color:${item.palette.fill}; color:${item.palette.contrast};`}
              >
                {item.number}
              </div>
              <p
                class={`absolute text-sm font-medium leading-snug text-text-dark ${item.labelClass}`}
              >
                <span
                  class="mb-2 block text-[0.7rem] font-semibold uppercase tracking-[0.22em]"
                  style={`color:${item.palette.accent};`}
                >
                  {item.number}
                </span>
                {item.label}
              </p>
            </div>
          ))
        }
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:hidden">
        {
          items.map((item) => (
            <div
              class="flex items-start gap-4 rounded-[1.5rem] px-5 py-4 text-left ring-1 ring-border/50"
              style={`background-color:${item.palette.card};`}
            >
              <div
                class="mt-1 flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-sm font-semibold shadow"
                style={`background-color:${item.palette.fill}; color:${item.palette.contrast};`}
              >
                {item.number}
              </div>
              <p class="text-sm leading-relaxed text-text-dark">{item.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
