---
import { markdownify } from "@/lib/utils/textConverter";
import { marked } from "marked";
import type { CollectionEntry } from "astro:content";
import ResponsiveImage from "@/components/ResponsiveImage.astro";

const imageDimensions = {
  "/images/experience-togo.webp": { width: 1600, height: 1200 },
  "/images/experience-togo-2.webp": { width: 900, height: 1200 },
  "/images/experience-togo-3.webp": { width: 900, height: 1200 },
  "/images/experience-yoga.webp": { width: 1050, height: 1400 },
  "/images/experience-yoga-2.webp": { width: 900, height: 1200 },
};

const imageWidths = {
  "/images/experience-togo.webp": [480, 768, 1024, 1200],
  "/images/experience-togo-2.webp": [360, 640, 900],
  "/images/experience-togo-3.webp": [360, 640, 900],
  "/images/experience-yoga.webp": [360, 640, 900, 1050],
  "/images/experience-yoga-2.webp": [360, 640, 900],
};

const dimensionsFor = (src: string) =>
  imageDimensions[src as keyof typeof imageDimensions] ?? {
    width: 1200,
    height: 900,
  };

const widthsFor = (src: string) =>
  imageWidths[src as keyof typeof imageWidths] ?? [360, 640, 960, 1200];

type Props = {
  experiences: CollectionEntry<"about">["data"]["experiences"];
};

const { experiences } = Astro.props;

const items = experiences
  ? await Promise.all(
      experiences.experience_list.map(async (exp) => ({
        ...exp,
        html: await marked.parse(exp.content),
      })),
    )
  : [];
---

{
  experiences && (
    <section class="section">
      <div class="container">
        <div class="row justify-center text-center">
          <div class="md:col-10 lg:col-7">
            <h2 set:html={markdownify(experiences.title)} />
          </div>
        </div>

        {items.map((exp, index) =>
          exp.images_below ? (
            <div class="mt-10 lg:mt-16">
              <div class="row justify-center">
                <div class="lg:col-10">
                  <h3 class="mb-4" set:html={markdownify(exp.title)} />
                  <div class="content" set:html={exp.html} />
                </div>
              </div>
              {exp.images && exp.images.length > 0 && (
                <div class="gx-4 row justify-center mt-8">
                  {exp.images.map((img) => (
                    <div class="mt-4 sm:col-6 lg:col-5">
                      <ResponsiveImage
                        class="w-full rounded-2xl object-cover shadow"
                        src={img}
                        alt={`Illustration de l'expérience : ${exp.title}`}
                        width={dimensionsFor(img).width}
                        height={dimensionsFor(img).height}
                        widths={widthsFor(img)}
                        sizes="(min-width: 1024px) 40vw, (min-width: 640px) 50vw, 100vw"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  ))}
                </div>
              )}
            </div>
          ) : (
            <div class="gx-5 row items-start mt-10 lg:mt-16">
              <div
                class={`lg:col-5 ${index % 2 === 0 ? "lg:order-0" : "lg:order-1"}`}
              >
                {exp.image && (
                  <ResponsiveImage
                    class="w-full rounded-2xl object-cover shadow-lg"
                    src={exp.image}
                    alt={`Photo principale de l'expérience : ${exp.title}`}
                    width={dimensionsFor(exp.image).width}
                    height={dimensionsFor(exp.image).height}
                    widths={widthsFor(exp.image)}
                    sizes="(min-width: 1024px) 40vw, 100vw"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                {exp.images && exp.images.length > 0 && (
                  <div class={`gx-4 row ${exp.image ? "mt-4" : ""}`}>
                    {exp.images.map((img, idx) => (
                      <div class="col-6">
                        <ResponsiveImage
                          class="aspect-[3/4] w-full rounded-xl object-cover shadow"
                          src={img}
                          alt={`Photo ${idx + 1} de l'expérience : ${exp.title}`}
                          width={dimensionsFor(img).width}
                          height={dimensionsFor(img).height}
                          widths={widthsFor(img)}
                          sizes="(min-width: 1024px) 20vw, 50vw"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    ))}
                  </div>
                )}
              </div>
              <div
                class={`mt-6 lg:col-7 lg:mt-0 ${
                  index % 2 === 0 ? "lg:order-1" : "lg:order-0"
                }`}
              >
                <h3 class="mb-4" set:html={markdownify(exp.title)} />
                <div class="content" set:html={exp.html} />
              </div>
            </div>
          )
        )}
      </div>
    </section>
  )
}
