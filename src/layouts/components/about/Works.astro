---
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";

type Props = {
  features: NonNullable<CollectionEntry<"about">["data"]["features"]>;
};
const {
  features: { title, button, features_list },
} = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="row items-center justify-between">
      <div class="md:col-5">
        <h2 class="text-center md:text-left" set:html={markdownify(title)} />
      </div>
      {
        button.enable && (
          <div class="mt-6 text-center md:col-3 md:mt-0 md:text-right">
            <a class="btn btn-primary" href={button.link}>
              {button.label}
            </a>
          </div>
        )
      }
    </div>
    <div class="row mt-14">
      {
        features_list.map((item) => (
          <div class="mb-8 sm:col-6 lg:col-4">
            <div class="rounded-xl bg-white p-6 shadow-lg lg:p-8">
              <h4 class="my-6" set:html={markdownify(item.title)} />
              <p set:html={markdownify(item.content)} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
