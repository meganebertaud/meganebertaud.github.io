---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import social from "@/config/social.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

const {
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
  meta_keywords,
  extra_schema,
} =
  Astro.props;
const pageImageUrl = new URL(
  image ? image : config.metadata.meta_image,
  config.site.base_url,
).href;
const siteLogoUrl = new URL(config.site.logo, config.site.base_url).href;
const profileImageUrl = new URL("/images/megane-bertaud.webp", config.site.base_url).href;
const appointmentUrl = config.params.appointment_url;
const mapUrl = config.params.map_url;
const linkedinUrl = social.main.find((item) => item.name === "linkedin")?.link;
const sameAs = [linkedinUrl, appointmentUrl].filter(Boolean);

const address = {
  "@type": "PostalAddress",
  "streetAddress": "73 rue Condillac",
  "addressLocality": "Bordeaux",
  "postalCode": "33000",
  "addressCountry": "FR"
};

const openingHoursSpecification = [
  {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Tuesday", "Wednesday"],
    "opens": "08:00",
    "closes": "19:00"
  }
];

const serviceOffers = [
  {
    "@type": "Offer",
    "name": "Séance d'ergothérapie en cabinet — 45 min",
    "price": "55",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "url": appointmentUrl
  },
  {
    "@type": "Offer",
    "name": "Séance d'ergothérapie en cabinet — 30 min",
    "price": "40",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "url": appointmentUrl
  },
  {
    "@type": "Offer",
    "name": "Bilan ergothérapique",
    "price": "200",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "url": appointmentUrl
  },
  {
    "@type": "Offer",
    "name": "Visite à domicile",
    "price": "200",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "url": appointmentUrl
  }
];

// Schema.org JSON-LD for Local Business
const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "name": "Mégane Bertaud — Ergothérapeute D.E.",
  "description": "Ergothérapeute D.E. spécialisée en rééducation neurologique, traumatologique et réadaptation fonctionnelle pour enfants et adultes.",
  "@id": "https://www.meganebertaud.fr/#localbusiness",
  "url": "https://www.meganebertaud.fr",
  "telephone": config.params.phone,
  "email": config.params.email,
  "address": address,
  "openingHours": "Tu,We 08:00-19:00",
  "openingHoursSpecification": openingHoursSpecification,
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "44.837789",
    "longitude": "-0.579180"
  },
  "sameAs": sameAs,
  "logo": siteLogoUrl,
  "image": pageImageUrl,
  "hasMap": mapUrl,
  "priceRange": "40€-200€",
  "medicalSpecialty": "OccupationalTherapy",
  "areaServed": {
    "@type": "City",
    "name": "Bordeaux"
  },
  "makesOffer": serviceOffers,
  "potentialAction": {
    "@type": "ReserveAction",
    "target": appointmentUrl,
    "name": "Prendre rendez-vous"
  }
});

// Schema.org JSON-LD for Person
const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Mégane Bertaud",
  "description": "Ergothérapeute D.E. spécialisée en pédiatrie, neurologie et réadaptation fonctionnelle.",
  "url": "https://www.meganebertaud.fr",
  "image": profileImageUrl,
  "sameAs": linkedinUrl ? [linkedinUrl] : [],
  "hasOccupation": {
    "@type": "Occupation",
    "name": "Ergothérapeute"
  },
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "HEPL de Liège"
  }
});

// Canonical URL - Fixed to handle root path correctly
const canonicalUrl = canonical || new URL(Astro.url.pathname, config.site.base_url).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }
    
    <!-- JSON-LD Schemas for SEO -->
    <script is:inline type="application/ld+json" set:html={localBusinessSchema} />
    <script is:inline type="application/ld+json" set:html={personSchema} />
    {
      extra_schema &&
        [extra_schema].flat().map((schema) => (
          <script
            is:inline
            type="application/ld+json"
            set:html={typeof schema === "string" ? schema : JSON.stringify(schema)}
          />
        ))
    }
    
    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="sWZ2vh2fYMpsXu_JrPMWg-54j0SVbi_Z3JWyHKfaZkE" />
    
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <link rel="icon" type="image/png" href={config.site.favicon} />
    <link rel="apple-touch-icon" href={config.site.logo} />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Author and social links -->
    {linkedinUrl && <link rel="me" href={linkedinUrl} />}
    <meta name="author" content={config.metadata.meta_author} />
    <!-- theme meta -->
    <meta name="theme-name" content="pinwheel-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    <link rel="canonical" href={canonicalUrl} itemprop="url" />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description
      )}
    />
    <!-- meta-keywords -->
    {meta_keywords && (
      <meta name="keywords" content={plainify(meta_keywords)} />
    )}

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title
      )}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description
      )}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description
      )}
    />

    <!-- og-image -->
    <meta
      property="og:image"
      content={pageImageUrl}
    />

    <!-- twitter-image -->
    <meta
      name="twitter:image"
      content={pageImageUrl}
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }
    <TwSizeIndicator />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
