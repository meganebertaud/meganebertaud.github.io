---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

const { title, meta_title, description, image, noindex, canonical, meta_keywords } =
  Astro.props;

// Schema.org JSON-LD for Local Business
const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Mégane Bertaud — Ergothérapeute D.E.",
  "description": "Ergothérapeute D.E. spécialisée en rééducation neurologique, traumatologique et réadaptation fonctionnelle pour enfants et adultes.",
  "@id": "https://www.meganebertaud.fr/#localbusiness",
  "url": "https://www.meganebertaud.fr",
  "telephone": "+33780298966",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "73 rue Condillac",
    "addressLocality": "Bordeaux",
    "postalCode": "33000",
    "addressCountry": "FR"
  },
  "openingHours": "Tu,We 08:00-19:00",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "44.837789",
    "longitude": "-0.579180"
  },
  "sameAs": ["https://www.docorga.com/"],
  "logo": "https://www.meganebertaud.fr/images/logo-megane.png",
  "image": "https://www.meganebertaud.fr/images/og-image.png",
  "hasMap": "https://www.google.com/maps/place/73+Rue+Condillac,+33000+Bordeaux/@44.837789,-0.579180",
  "priceRange": "$$"
});

// Schema.org JSON-LD for Person
const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Mégane Bertaud",
  "description": "Ergothérapeute D.E. spécialisée en pédiatrie, neurologie et réadaptation fonctionnelle.",
  "url": "https://www.meganebertaud.fr",
  "image": "https://www.meganebertaud.fr/images/megane-bertaud.png",
  "sameAs": ["https://www.linkedin.com/in/megane-bertaud/"],
  "hasOccupation": {
    "@type": "Occupation",
    "name": "Ergothérapeute"
  },
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "HEPL de Liège"
  }
});

// Canonical URL - Fixed to handle root path correctly
const canonicalUrl = canonical || new URL(Astro.url.pathname, config.site.base_url).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }
    
    <!-- JSON-LD Schemas for SEO -->
    <script type="application/ld+json" set:html={localBusinessSchema} />
    <script type="application/ld+json" set:html={personSchema} />
    
    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="sWZ2vh2fYMpsXu_JrPMWg-54j0SVbi_Z3JWyHKfaZkE" />
    
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- Modern favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Author and social links -->
    <link rel="me" href="https://www.linkedin.com/in/megane-bertaud/" />
    <meta name="author" content={config.metadata.meta_author} />
    <!-- theme meta -->
    <meta name="theme-name" content="pinwheel-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    <link rel="canonical" href={canonicalUrl} itemprop="url" />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description
      )}
    />
    <!-- meta-keywords -->
    {Astro.props.meta_keywords && (
      <meta name="keywords" content={plainify(Astro.props.meta_keywords)} />
    )}

    <ClientRouter />

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title
      )}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description
      )}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description
      )}
    />

    <!-- og-image -->
    <meta
      property="og:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />

    <!-- twitter-image -->
    <meta
      name="twitter:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />
    <meta name="twitter:creator" content="@meganebertaud" />
    <meta name="twitter:site" content="@meganebertaud" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }
    <TwSizeIndicator />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
